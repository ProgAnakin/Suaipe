{
  "name": "suaipe",
  "description": "iPad-first product-discovery kiosk for Suaipe — swipe-based quiz, multilingual transactional emails, real-time analytics, multi-store management. Built solo by Costanzo Annichini.",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps webkit",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "test:db": "bash supabase/tests/run-local.sh",
    "test:restore": "bash supabase/tests/restore-local.sh",
    "typecheck:edge": "tsc -p tsconfig.edge.json --noEmit",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "readiness": "python3 scripts/readiness.py",
    "test:edge:runtime": "npm exec --yes --package=deno@2.9.6 -- deno test --no-config supabase/tests/edge-runtime.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@sentry/react": "^10.59.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob@>=9 <14.0.2": "^14.0.4",
    "minimatch@>=7 <11.0.1": "^11.0.5"
  }
}
