{
  "name": "suaipe-video",
  "private": true,
  "version": "0.0.0",
  "description": "Programmatic videos for Suaipe, built with Remotion. Isolated from the app: own package.json and node_modules.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "still": "remotion still src/index.ts SmokeTest out/smoke.png --frame=60",
    "render": "remotion render src/index.ts SmokeTest out/smoke.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.8.3"
  }
}
