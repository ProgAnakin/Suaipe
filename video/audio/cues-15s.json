  "sections": [
    {
      "name": "hook",
      "from": 0,
      "to": 4,
      "brief": "Observant. No drums: a dark drone, a faint heartbeat, the harmony left open; 0.25 s of near-silence before the hit at 4.0."
    },
    {
      "name": "idea",
      "from": 4,
      "to": 4.5,
      "brief": "First resolution on C: the logo hit, the motif's question (G-A). The sub pulse begins, half-time."
    },
    {
      "name": "handoff",
      "from": 4.5,
      "to": 5.5,
      "brief": "A pad on G, a soft pulse, the shop's room tone; the interface takes over as the camera enters the tablet."
    },
    {
      "name": "swipes",
      "from": 5.5,
      "to": 8.5,
      "brief": "The swipes are the rhythm: tuned yes (rising, right) and no (falling, left) phrases over a pad and the pulse; no keys."
    },
    {
      "name": "scan",
      "from": 8.5,
      "to": 10.5,
      "brief": "A tonal riser, the pad opens, everything cuts for 0.25 s of air before the 98 %."
    },
    {
      "name": "match",
      "from": 10.5,
      "to": 11.5,
      "brief": "The 98 % bloom on C: the first, smaller peak. A rolled felt chord, a glass shimmer, then calm."
    },
    {
      "name": "resolve",
      "from": 11.5,
      "to": 12.5,
      "brief": "★ The handshake: the film's one big resolved C chord, full and warm, no cymbal; the motif completes on the logo at 61.0."
    },
    {
      "name": "signature",
      "from": 12.5,
      "to": 15,
      "brief": "Cadd9 rings; the last second is still and the tail fades to true silence."
    }
  ],
