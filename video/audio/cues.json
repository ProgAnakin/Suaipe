  "sections": [
    {
      "name": "hook",
      "from": 0,
      "to": 4,
      "brief": "Observant. No drums: a dark drone, a faint heartbeat, the harmony left open; 0.25 s of near-silence before the hit at 4.0."
    },
    {
      "name": "idea",
      "from": 4,
      "to": 6,
      "brief": "First resolution on C: the logo hit, the motif's question (G-A). The sub pulse begins, half-time."
    },
    {
      "name": "handoff",
      "from": 6,
      "to": 8,
      "brief": "A pad on G, a soft pulse, the shop's room tone; the interface takes over as the camera enters the tablet."
    },
    {
      "name": "form",
      "from": 8,
      "to": 14,
      "brief": "Pad and a sparse felt piano; room for the language ticks, the typing texture, the consent click and the taps."
    },
    {
      "name": "swipes",
      "from": 14,
      "to": 20,
      "brief": "The swipes are the rhythm: tuned yes (rising, right) and no (falling, left) phrases over a pad and the pulse; no keys."
    },
    {
      "name": "scan",
      "from": 20,
      "to": 22,
      "brief": "A tonal riser, the pad opens, everything cuts for 0.25 s of air before the 98 %."
    },
    {
      "name": "match",
      "from": 22,
      "to": 26,
      "brief": "The 98 % bloom on C: the first, smaller peak. A rolled felt chord, a glass shimmer, then calm."
    },
    {
      "name": "email",
      "from": 26,
      "to": 34,
      "brief": "Intimate: low-passed felt piano, the pulse on beat 1 only. The notification and the code ding sit on top."
    },
    {
      "name": "store",
      "from": 34,
      "to": 44,
      "brief": "Steady and competent: a firm sub pulse and one quiet off-beat tick, confident chords; one soft 'land' when a lead reaches the CRM."
    },
    {
      "name": "consult",
      "from": 44,
      "to": 54,
      "brief": "Calm, a place to learn: the e-mail's low-passed felt piano again, a light pulse; the search, the tap and the two call-outs are small glass ticks."
    },
    {
      "name": "system",
      "from": 54,
      "to": 58,
      "brief": "Precise and calm: gated pad and staccato plucks, less busy than before; the pulse stops cleanly at 57.5."
    },
    {
      "name": "human",
      "from": 58,
      "to": 60,
      "brief": "Warm and quiet: a soft pad and felt keys on G leaning towards C, the room tone, the bag rustle; no pulse."
    },
    {
      "name": "resolve",
      "from": 60,
      "to": 62,
      "brief": "★ The handshake: the film's one big resolved C chord, full and warm, no cymbal; the motif completes on the logo at 61.0."
    },
    {
      "name": "signature",
      "from": 62,
      "to": 64.5,
      "brief": "Cadd9 rings; the last second is still and the tail fades to true silence."
    }
  ],
