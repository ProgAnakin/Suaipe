# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon/publishable key ONLY — NEVER use the service-role key here (bypasses RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ── Site URL (optional) ──────────────────────────────────────────────────────
# Absolute origin of the deployed PWA. Used to turn bundled product images
# (/products/x.png) into absolute URLs so they render in the match email.
# Defaults to https://suaipe.vercel.app. Set the matching SITE_URL secret on the
# on-session-created Edge Function if you change the deployment domain.
VITE_SITE_URL=https://suaipe.vercel.app

# Portfolio builds default to demo, including Production. Never connect a public demo to customer data.
VITE_DEMO_MODE=true
# Separate safeguard against old deployment settings accidentally enabling collection.
VITE_ALLOW_REAL_CUSTOMER_DATA=false
# Real controller identity and monitored contact, mandatory for Vercel production.
VITE_PRIVACY_CONTROLLER=Costanzo Annichini
# Fictitious reserved example, not a channel for customer requests.
VITE_PRIVACY_CONTACT=suaipe@example.invalid
# Future real operation only: requires matching server app_config marketing_enabled=true,
# reviewed notice, monitored real contact and an unsubscribe process. No campaigns are sent by this app.
VITE_ENABLE_MARKETING=false
# Error reporting is opt-in. Session replay/performance tracing are disabled.
VITE_ENABLE_ERROR_MONITORING=false
VITE_SENTRY_DSN=

# Sourcemap upload — set ONLY in CI / Vercel build env, never client-side.
# Without all three, vite.config.ts skips the upload step (and skips emitting
# .map files entirely, so nothing leaks).
#   SENTRY_AUTH_TOKEN — Personal/Org token with project:write + release:admin
#   SENTRY_ORG        — org slug, e.g. "suaipe"
#   SENTRY_PROJECT    — project slug, e.g. "suaipe"
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Edge Function secrets ──────────────────────────────────────────────────────
# Set via Supabase Dashboard → Edge Functions → <function> → Secrets
# (or: npx supabase secrets set KEY=value)
#
# STAFF_PIN  ★ REQUIRED for PIN login to work ★
#   The plaintext staff PIN used by AdminPinOverlay and MatchResult change-email.
#   Set on the "verify-pin" Edge Function.
#   Example: STAFF_PIN=<choose-a-numeric-pin>
#   The Edge Function compares it directly (constant-time) — the value never
#   reaches the client.  Fallback: if this secret is absent, the function tries
#   bcrypt comparison against app_config.staff_pin_hash in the database
#   (requires migration 20260507000004 to have been run in the SQL Editor).
#
# BREVO_API_KEY            — Brevo transactional email
# EMAIL_SENDER             — Brevo sender address (must be DKIM-verified).
#                            Falls back to noreply@suaipe.app if unset.
# SITE_URL                 — Deployed PWA origin used to absolutise root-relative
#                            product images in the email. Falls back to
#                            https://suaipe.vercel.app. Keep in sync with VITE_SITE_URL.
# ENABLE_SHEETS_RELAY     — explicit true to enable the optional CRM copy
# GOOGLE_SHEETS_WEBHOOK_URL — CRM relay webhook (optional)
# MAINTENANCE_SECRET       — random secret for the daily privacy scheduler
# WHITELIST_EMAILS         — Staff emails bypassing cooldown (comma-separated)
# ALLOWED_ORIGIN  ★ RECOMMENDED ★
#   CORS allowlist (e.g. https://your-domain.com). When unset, Edge Functions
#   fail closed: browser cross-origin requests are silently rejected. Required
#   for the kiosk to talk to verify-pin from a browser.
# WEBHOOK_SECRET  ★ REQUIRED ★
#   Shared secret for the Postgres webhook → on-session-created.
#   Add as HTTP header "x-webhook-secret: <value>" in
#   Supabase Dashboard → Database → Webhooks → on-session-created.
#   Missing/mismatched secrets fail closed; no email is sent.
